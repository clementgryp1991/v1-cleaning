[{"t": "Ramen en glas", "g": "Dienst", "u": "diensten/ramen-en-glas/", "k": "Ramen, glazen wanden en lichtstraten, binnen en buiten."}, {"t": "Zonnepanelen reinigen", "g": "Dienst", "u": "diensten/zonnepanelen/", "k": "Panelen op bedrijfsdaken reinigen zonder agressieve middelen."}, {"t": "Zonnepanelen reinigen met drones", "g": "Dienst", "u": "diensten/zonnepanelen-drone/", "k": "Drone-reiniging voor grote of moeilijk bereikbare industriële daken, met minder werk op hoogte."}, {"t": "Gevel-, dak- en buitenreiniging", "g": "Dienst", "u": "diensten/gevel-en-dakreiniging/", "k": "Gevels, PVC, daken, laadkades en verharding, met lage of hoge druk naargelang de ondergrond."}, {"t": "Bouw- en opleveringsschoonmaak", "g": "Dienst", "u": "diensten/opleveringsschoonmaak/", "k": "Bouwstof en resten weg na nieuwbouw of renovatie, zodat het gebouw klaar is voor gebruik."}, {"t": "Eindschoonmaak bij verhuis", "g": "Dienst", "u": "diensten/eindschoonmaak/", "k": "Een leeg pand grondig schoon na een verhuis, ontruiming of het einde van een huur."}, {"t": "Kantoorschoonmaak", "g": "Dienst", "u": "diensten/kantoorschoonmaak/", "k": "Bureaus, vergaderzalen, keuken en sanitair. Overdag of na de kantooruren."}, {"t": "Winkelschoonmaak", "g": "Dienst", "u": "diensten/winkelschoonmaak/", "k": "Winkelvloer, inkom, paskamers en etalage, ingepland rond je openingsuren."}, {"t": "Industriële schoonmaak", "g": "Dienst", "u": "diensten/industriele-schoonmaak/", "k": "Magazijnen, bedrijfshallen en logistieke sites, afgestemd op je bedrijfsplanning."}, {"t": "Industriële vloerreiniging", "g": "Dienst", "u": "diensten/vloerreiniging/", "k": "Schrobzuigen van betonvloeren, coatings en loopzones, met de juiste machine per vloer."}, {"t": "Productie- en machinereiniging", "g": "Dienst", "u": "diensten/productie-en-machinereiniging/", "k": "Lijnen, machines en productieruimtes, volgens je reinigings- en hygiëneplan."}, {"t": "Dieptereiniging en grote kuis", "g": "Dienst", "u": "diensten/dieptereinig